# Copy to .env.local for development, and set the same values in the Vercel
# project settings for production. Never commit real values — .env.local is
# gitignored.
#
# No variable here is prefixed NEXT_PUBLIC_, and none should be. The prefix
# does not grant access; it inlines the value into the browser bundle, where
# anyone can read it. Every variable below is read only by server code
# (API routes and the scripts/ CLIs), which reads the real environment at
# runtime. The browser only ever calls /api/on-duty.

# --- Supabase (Settings -> API) ---
# Project URL, e.g. https://abcdefghijklmno.supabase.co (no trailing slash)
SUPABASE_URL=
# anon / publishable key — restricted to select by RLS
SUPABASE_ANON_KEY=
# service_role / secret key — BYPASSES RLS, full read-write on the database.
# Used by the scrapers and the cron route only. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Site ---
# Canonical origin, used for canonical tags, hreflang, robots.txt, the
# sitemap and the share card's image URL. Leave unset in production: the
# code falls back to https://acikeczanevarmi.com. Set it on a preview
# deployment so the preview does not claim to be the live site.
# SITE_URL=

# --- Cron ---
# Shared secret guarding GET /api/cron/sync-duty. Vercel Cron sends it as
# "Authorization: Bearer <CRON_SECRET>". Use 32+ random characters, e.g.
#   openssl rand -base64 32
# If unset the endpoint refuses every request, so the roster never syncs.
CRON_SECRET=

# --- Alerting (optional but recommended) ---
# Any webhook that accepts a JSON POST — Slack and Discord both work as-is.
# Fires when the duty sync fails. Without it a broken scraper is invisible to
# you: the app keeps serving the last known roster behind the stale flag, and
# only end users see the banner.
ALERT_WEBHOOK_URL=

# --- Scraper ---
# Contact address embedded in the User-Agent sent to kteb.org (polite scraping)
SCRAPER_CONTACT=mailto:you@example.com

# --- Local development only ---
# MOCK_DATA=1 makes /api/on-duty serve the fixture in src/lib/mock.ts so the UI
# runs with no Supabase project. Leave this unset everywhere else: with it on,
# the app serves invented pharmacies and phone numbers as if they were real.
# MOCK_DATA=1
