# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — scripts and cron only, never exposed to the client
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret for GET /api/cron/sync-duty (Vercel sends it as "Authorization: Bearer <CRON_SECRET>")
CRON_SECRET=
# Contact put into the scraper User-Agent (polite scraping)
SCRAPER_CONTACT=mailto:fathgnc.dev@gmail.com
